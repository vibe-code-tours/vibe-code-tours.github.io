---
// src/components/GalleryBody.astro
import {
  getProjects,
  typeBuckets,
  stackList,
  TYPE_LABELS,
} from "../lib/projects.mjs";
import { t } from "../i18n/utils";

interface Props {
  locale?: "en" | "my";
}
const { locale = "en" } = Astro.props;
const s = t(locale).gallery;

const projects = getProjects();
const types = typeBuckets(projects);
const stacks = stackList(projects).slice(0, 12); // top stacks as chips

const CHIP =
  "cursor-pointer rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-xs font-semibold text-gray-400 transition hover:text-white aria-pressed:border-accent-500 aria-pressed:bg-accent-500 aria-pressed:text-white";

const ogFallback = (repoUrl: string) => {
  const m = repoUrl.match(/github\.com\/([^/]+)\/([^/#?]+)/i);
  return m ? `https://opengraph.githubassets.com/1/${m[1]}/${m[2]}` : "";
};

// Strings + type labels the client-side script needs, serialized once for the island.
const scriptI18n = JSON.stringify({
  loadingSlides: s.loadingSlides,
  slidesUnavailable: s.slidesUnavailable,
  liveBtn: s.liveBtn,
  repoBtn: s.repoBtn,
  slidesBtn: s.slidesBtn,
  types: s.types,
});
---

<section class="mx-auto max-w-6xl px-5 py-12 sm:px-6">
  <p class="section-label">{s.label}</p>
  <h1 class="mt-2 text-center text-3xl font-extrabold sm:text-4xl">
    {s.heading}
  </h1>
  <p class="mx-auto mt-3 max-w-xl text-center text-gray-400">
    {s.intro}
  </p>

  {
    projects.length === 0 ? (
      <p class="mt-10 text-center text-gray-600">{s.empty}</p>
    ) : (
      <>
        <div class="mt-8 flex flex-col items-center gap-3">
          <input
            id="project-search"
            type="search"
            placeholder={s.searchPlaceholder}
            aria-label={s.searchPlaceholder}
            class="w-full max-w-sm rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm text-white placeholder:text-gray-500 focus:border-accent-500 focus:outline-none"
          />

          <div id="type-filter" class="flex flex-wrap justify-center gap-2">
            <button class={CHIP} data-type="*" aria-pressed="true">
              {s.allTypes}
            </button>
            {types.map((ty) => (
              <button class={CHIP} data-type={ty.type} aria-pressed="false">
                {TYPE_LABELS[ty.type as keyof typeof TYPE_LABELS]} · {ty.count}
              </button>
            ))}
          </div>

          <div id="stack-filter" class="flex flex-wrap justify-center gap-2">
            <button class={CHIP} data-stack="*" aria-pressed="true">
              {s.anyStack}
            </button>
            {stacks.map((st) => (
              <button class={CHIP} data-stack={st.name} aria-pressed="false">
                {st.name}
              </button>
            ))}
          </div>

          <p id="project-count" class="font-mono text-xs text-gray-500">
            {projects.length} {s.countUnit}
          </p>
        </div>

        <div
          id="gallery-grid"
          class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
          data-i18n={scriptI18n}
        >
          {projects.map((c) => {
            const shotSrc = c.screenshot_url ?? ogFallback(c.repo_url);
            return (
              <button
                class="project-cell group relative overflow-hidden rounded-xl border border-white/10 bg-white/5 text-left transition hover:-translate-y-1 hover:border-accent-500/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
                data-type={c.type}
                data-stack={(c.stack ?? []).join("|")}
                data-project={JSON.stringify(c)}
              >
                <div class="relative aspect-video overflow-hidden bg-black/40">
                  {shotSrc && (
                    <img
                      src={shotSrc}
                      alt={`${c.title} screenshot`}
                      loading="lazy"
                      class="h-full w-full object-cover transition duration-300 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                    />
                  )}
                  {c.chapter && (
                    <span class="absolute right-2 top-2 rounded-full bg-black/60 px-2 py-0.5 font-mono text-[10px] font-semibold text-white backdrop-blur-sm">
                      Ch {c.chapter}
                    </span>
                  )}
                </div>
                <div class="p-4">
                  <div class="flex items-center gap-2">
                    <img
                      src={`https://github.com/${c.github}.png`}
                      alt=""
                      width="24"
                      height="24"
                      loading="lazy"
                      class="h-6 w-6 rounded-full border border-white/10"
                    />
                    <span class="truncate font-semibold text-white">
                      {c.title}
                    </span>
                  </div>
                  <p class="mt-1 truncate text-sm text-gray-400 transition group-hover:text-accent-300">
                    @{c.name}
                  </p>
                  {c.desc && (
                    <p class="mt-2 line-clamp-2 text-sm text-gray-500">
                      {c.desc}
                    </p>
                  )}
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    <span class="rounded-full bg-accent-500/15 px-2 py-0.5 font-mono text-[10px] font-semibold text-accent-300">
                      {TYPE_LABELS[c.type as keyof typeof TYPE_LABELS]}
                    </span>
                    {(c.stack ?? []).slice(0, 3).map((tag) => (
                      <span class="rounded-full bg-white/5 px-2 py-0.5 font-mono text-[10px] text-gray-400">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </button>
            );
          })}
        </div>

        <p id="gallery-empty" class="mt-10 text-center text-gray-600" hidden>
          {s.noMatches}
        </p>
      </>
    )
  }

  <div
    id="lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Project detail"
  >
    <div
      class="relative flex max-h-[90vh] w-full max-w-3xl flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#0b0b0d]"
    >
      <button
        id="lightbox-close"
        class="absolute right-3 top-3 z-10 rounded-full bg-white/10 p-2 text-white transition hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500"
        aria-label="Close">✕</button
      >
      <div class="overflow-y-auto">
        <div class="bg-black/40">
          <img
            id="lb-shot"
            src=""
            alt=""
            class="max-h-[42vh] w-full object-contain"
          />
          <div
            id="lb-thumbs"
            class="flex gap-2 overflow-x-auto px-3 pb-3 pt-1 empty:hidden"
          >
          </div>
        </div>
        <div class="p-5">
          <div class="flex items-center gap-3">
            <img
              id="lb-avatar"
              src=""
              alt=""
              width="32"
              height="32"
              class="h-8 w-8 rounded-full border border-white/10"
            />
            <div>
              <h2 id="lb-title" class="text-lg font-bold text-white"></h2>
              <a
                id="lb-name"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-gray-400 transition hover:text-accent-300 hover:underline focus-visible:text-accent-300 focus-visible:outline-none"
              ></a>
            </div>
          </div>
          <p id="lb-desc" class="mt-3 text-sm text-gray-300"></p>
          <div id="lb-tags" class="mt-3 flex flex-wrap gap-1.5"></div>
          <div id="deck-mount" class="mt-5"></div>
          <div id="lb-links" class="mt-5 flex flex-wrap gap-3"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const searchEl = document.getElementById(
    "project-search",
  ) as HTMLInputElement | null;
  const typeBar = document.getElementById("type-filter");
  const stackBar = document.getElementById("stack-filter");
  const count = document.getElementById("project-count");
  const empty = document.getElementById("gallery-empty");
  const grid = document.getElementById("gallery-grid");
  const cells = Array.from(
    document.querySelectorAll<HTMLElement>("#gallery-grid .project-cell"),
  );

  interface GalleryI18n {
    loadingSlides: string;
    slidesUnavailable: string;
    liveBtn: string;
    repoBtn: string;
    slidesBtn: string;
    types: Record<string, string>;
  }
  const FALLBACK_I18N: GalleryI18n = {
    loadingSlides: "Loading slides…",
    slidesUnavailable: "Slides unavailable — open on GitHub ↗",
    liveBtn: "Live site ↗",
    repoBtn: "Repo ↗",
    slidesBtn: "Open slides ↗",
    types: {
      "web-app": "Web app",
      cli: "CLI",
      bot: "Bot",
      api: "API",
      mobile: "Mobile",
      game: "Game",
      library: "Library",
      other: "Other",
    },
  };
  let I18N: GalleryI18n = FALLBACK_I18N;
  try {
    const raw = grid?.dataset.i18n;
    if (raw) I18N = { ...FALLBACK_I18N, ...JSON.parse(raw) };
  } catch {}

  let activeType = "*",
    activeStack = "*",
    query = "";

  function apply() {
    let shown = 0;
    for (const cell of cells) {
      const okType = activeType === "*" || cell.dataset.type === activeType;
      const okStack =
        activeStack === "*" ||
        (cell.dataset.stack ?? "").split("|").includes(activeStack);
      const okText =
        query === "" || (cell.textContent ?? "").toLowerCase().includes(query);
      const show = okType && okStack && okText;
      cell.classList.toggle("hidden", !show);
      if (show) shown++;
    }
    if (empty) empty.toggleAttribute("hidden", shown !== 0);
    if (count)
      count.textContent =
        shown === cells.length
          ? `${cells.length} projects`
          : `${shown} of ${cells.length}`;
  }

  function wireBar(
    bar: HTMLElement | null,
    attr: string,
    set: (v: string) => void,
  ) {
    bar?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>(
        `[data-${attr}]`,
      );
      if (!btn) return;
      set(btn.dataset[attr] ?? "*");
      bar
        .querySelectorAll<HTMLElement>(`[data-${attr}]`)
        .forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      apply();
    });
  }
  wireBar(typeBar, "type", (v) => (activeType = v));
  wireBar(stackBar, "stack", (v) => (activeStack = v));
  searchEl?.addEventListener("input", () => {
    query = searchEl.value.trim().toLowerCase();
    apply();
  });

  // Subtle stagger fade-in on scroll.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries)
          if (en.isIntersecting) {
            en.target.classList.add("in");
            io.unobserve(en.target);
          }
      },
      { rootMargin: "0px 0px -10% 0px" },
    );
    cells.forEach((c) => io.observe(c));
  } else {
    cells.forEach((c) => c.classList.add("in"));
  }

  const lb = document.getElementById("lightbox");
  const lbShot = document.getElementById("lb-shot") as HTMLImageElement | null;
  const lbThumbs = document.getElementById("lb-thumbs");
  const lbAvatar = document.getElementById(
    "lb-avatar",
  ) as HTMLImageElement | null;
  const lbTitle = document.getElementById("lb-title");
  const lbName = document.getElementById("lb-name");
  const lbDesc = document.getElementById("lb-desc");
  const lbTags = document.getElementById("lb-tags");
  const lbLinks = document.getElementById("lb-links");
  const deckMount = document.getElementById("deck-mount");

  function ogFallback(repoUrl: string) {
    const m = repoUrl.match(/github\.com\/([^/]+)\/([^/#?]+)/i);
    return m ? `https://opengraph.githubassets.com/1/${m[1]}/${m[2]}` : "";
  }

  function linkBtn(label: string, href: string) {
    const a = document.createElement("a");
    a.href = href;
    a.target = "_blank";
    a.rel = "noopener noreferrer";
    a.textContent = label;
    a.className =
      "rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:border-accent-500 hover:bg-accent-500";
    return a;
  }

  function openLightbox(c: any) {
    if (!lb) return;
    // Screenshot gallery: full set from the report/repo, cover first. Fall back
    // to the single cover, then the GitHub OG card if a repo has no shots.
    const shots: string[] =
      Array.isArray(c.screenshots) && c.screenshots.length
        ? c.screenshots
        : [c.screenshot_url ?? ogFallback(c.repo_url)].filter(Boolean);
    if (lbShot) {
      if (shots.length) {
        lbShot.src = shots[0];
        lbShot.hidden = false;
      } else {
        lbShot.removeAttribute("src");
        lbShot.hidden = true;
      }
      lbShot.alt = `${c.title} screenshot`;
    }
    if (lbThumbs) {
      lbThumbs.innerHTML = "";
      if (shots.length > 1) {
        shots.forEach((src, i) => {
          const t = document.createElement("button");
          t.type = "button";
          t.className =
            "shrink-0 overflow-hidden rounded-md border transition " +
            (i === 0
              ? "border-accent-500"
              : "border-white/10 hover:border-white/30");
          const img = document.createElement("img");
          img.src = src;
          img.loading = "lazy";
          img.alt = `${c.title} screenshot ${i + 1}`;
          img.className = "h-14 w-20 object-cover";
          t.appendChild(img);
          const select = () => {
            if (lbShot) lbShot.src = src;
            for (const el of lbThumbs.children)
              el.className =
                el === t
                  ? "shrink-0 overflow-hidden rounded-md border border-accent-500 transition"
                  : "shrink-0 overflow-hidden rounded-md border border-white/10 transition hover:border-white/30";
          };
          t.addEventListener("mouseenter", select); // swap on hover
          t.addEventListener("focus", select); // keyboard
          t.addEventListener("click", select); // touch
          lbThumbs.appendChild(t);
        });
      }
    }
    if (lbAvatar) lbAvatar.src = `https://github.com/${c.github}.png`;
    if (lbTitle) lbTitle.textContent = c.title;
    if (lbName) {
      lbName.textContent = `@${c.github}`;
      (lbName as HTMLAnchorElement).href = `https://github.com/${c.github}`;
    }
    if (lbDesc) lbDesc.textContent = c.desc ?? "";
    if (lbTags) {
      lbTags.innerHTML = "";
      const type = document.createElement("span");
      type.className =
        "rounded-full bg-accent-500/15 px-2 py-0.5 font-mono text-[10px] font-semibold text-accent-300";
      type.textContent = I18N.types[c.type] ?? c.type;
      lbTags.appendChild(type);
      for (const s of c.stack ?? []) {
        const el = document.createElement("span");
        el.className =
          "rounded-full bg-white/5 px-2 py-0.5 font-mono text-[10px] text-gray-400";
        el.textContent = s;
        lbTags.appendChild(el);
      }
    }
    if (lbLinks) {
      lbLinks.innerHTML = "";
      if (c.live_url) lbLinks.appendChild(linkBtn(I18N.liveBtn, c.live_url));
      lbLinks.appendChild(linkBtn(I18N.repoBtn, c.repo_url));
      if (c.slides_raw)
        lbLinks.appendChild(linkBtn(I18N.slidesBtn, c.slides_raw));
    }
    if (deckMount) deckMount.innerHTML = ""; // Task B4 fills this
    lb.classList.remove("hidden");
    lb.classList.add("flex");
    document.body.style.overflow = "hidden";
    (window as any).__renderDeck?.(c); // B4 hook (no-op until B4)
  }

  function closeLightbox() {
    if (!lb) return;
    lb.classList.add("hidden");
    lb.classList.remove("flex");
    document.body.style.overflow = "";
    if (deckMount) {
      deckMount.innerHTML = "";
      deckMount.dataset.deckToken = "closed";
    }
  }

  for (const cell of cells) {
    cell.addEventListener("click", () => {
      try {
        openLightbox(JSON.parse(cell.dataset.project ?? "{}"));
      } catch {}
    });
  }
  document
    .getElementById("lightbox-close")
    ?.addEventListener("click", closeLightbox);
  lb?.addEventListener("click", (e) => {
    if (e.target === lb) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });
</script>

<style>
  .project-cell {
    opacity: 0;
    transform: translateY(16px);
  }
  .project-cell.in {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .project-cell {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  @media (scripting: none) {
    .project-cell {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Inline marp deck renderer. Lazy-loads Marp only when a deck is first shown.
  function rewriteRelPaths(md: string, base: string) {
    const b = base.endsWith("/") ? base : base + "/";
    return md.replace(/(\]\()([^)]+)(\))/g, (m, open, target, close) => {
      const t = target.trim();
      if (/^(https?:|data:|#|mailto:)/i.test(t)) return m;
      return `${open}${b}${t.replace(/^\.?\//, "")}${close}`;
    });
  }

  let marpPromise: Promise<any> | null = null;
  async function getMarp() {
    if (!marpPromise) {
      marpPromise = import("@marp-team/marp-core").then(
        ({ Marp }) => new Marp({ html: false }),
      );
    }
    return marpPromise;
  }

  const grid = document.getElementById("gallery-grid");
  let deckI18n = {
    loadingSlides: "Loading slides…",
    slidesUnavailable: "Slides unavailable — open on GitHub ↗",
  };
  try {
    const raw = grid?.dataset.i18n;
    if (raw) deckI18n = { ...deckI18n, ...JSON.parse(raw) };
  } catch {}

  let deckCallToken = 0;

  (window as any).__renderDeck = async (c: any) => {
    const mount = document.getElementById("deck-mount");
    if (!mount) return;
    // Token lives on the DOM node (shared with the lightbox script above) so we can tell,
    // after an await, whether a newer call has started or the lightbox was closed in the meantime.
    const token = String(++deckCallToken);
    mount.dataset.deckToken = token;
    if (!c.slides_raw) {
      mount.innerHTML = "";
      return;
    }
    mount.innerHTML = `<p class="font-mono text-xs text-gray-500">${deckI18n.loadingSlides}</p>`;
    try {
      const res = await fetch(c.slides_raw);
      if (!res.ok) throw new Error(String(res.status));
      let md = await res.text();
      if (c.slides_base) md = rewriteRelPaths(md, c.slides_base);
      const marp = await getMarp();
      const { html, css } = marp.render(md);
      // Bail if a newer __renderDeck call started, or the lightbox was closed (deck-mount cleared), while we were fetching/rendering.
      if (mount.dataset.deckToken !== token) return;
      // Marp emits a bespoke presenter <script>; the iframe is sandboxed (no
      // allow-scripts) so it can't run and only logs a CSP error. Slides render
      // static here — strip it.
      const body = html.replace(/<script[\s\S]*?<\/script>/gi, "");
      const srcdoc = `<!doctype html><html><head><meta charset="utf8"><style>${css}
        html,body{margin:0;background:#0b0b0d} .marpit{transform-origin:top left}</style></head>
        <body>${body}</body></html>`;
      const iframe = document.createElement("iframe");
      iframe.setAttribute("sandbox", "");
      iframe.className =
        "h-[46vh] w-full rounded-lg border border-white/10 bg-black";
      iframe.srcdoc = srcdoc;
      mount.innerHTML = "";
      mount.appendChild(iframe);
    } catch (e) {
      if (mount.dataset.deckToken !== token) return;
      mount.innerHTML = `<a href="${c.repo_url}" target="_blank" rel="noopener noreferrer"
        class="font-mono text-xs text-gray-400 underline">${deckI18n.slidesUnavailable}</a>`;
    }
  };
</script>
